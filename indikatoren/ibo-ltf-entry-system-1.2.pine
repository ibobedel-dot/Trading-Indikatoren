//@version=6
indicator("Ibo LTF Entry System 1.2", shorttitle = "Ibo LTF 1.2", overlay = true, max_labels_count = 500, max_lines_count = 500)

// =====================================================================
// IBO LTF ENTRY SYSTEM 1.2 — für M1, M2 und M5
// 1 Liquidität : signifikante Swing-Hochs (BSL) / -Tiefs (SSL) plus Vortag, Vorwoche und Asia-Range
//                (Schlüssel-Levels zählen immer als stark). Jedes Level wird nur einmal abgeholt.
// 2 Sweep      : Grab (Close zurück im Level innerhalb von 1–3 Kerzen) oder Sweep (Preis bleibt
//                mindestens 6, höchstens 30 Minuten jenseits). Tiefe 0,1–1 × ATR.
//                Danach Reaktion: Verdrängungskerze ≥ 0,7 × ATR in Gegenrichtung.
// 3 Plan       : die erste FVG danach wird zum Plan (Entry, SL, TP).
//                Entstehen vor der Berührung weitere FVGs, springt der Plan auf die M5-FVG.
// 4 Ende       : Berührung, ungültig (TP vor Berührung, Kerze schließt durch die FVG, Zeit abgelaufen).
//                Danach wird das Ergebnis (TP / SL) verfolgt und als Historie gezeigt.
// Trend        : Gegen-Trend-Setups werden nur markiert (⚠), Alarme nur für Mit-Trend-Setups.
// Alarme       : kurz, für Watchlist-Alarme geeignet, optional nur in London / NY AM / NY PM.
// Alle Signale nur auf Kerzenschluss. Zeiten: Europe/Vienna (NY-Sessions in New-Yorker Zeit).
// =====================================================================

// ---------- Typ für einen Plan ----------
type Plan
    int dir
    float top
    float bot
    float entry
    float sl
    float tp
    float rr
    float fvgSz
    int birth
    int sweepBar
    int sweepTime
    int winEnd
    string grade
    bool eq
    bool h4ok
    bool strong = false
    bool withTrend = true
    bool alerted = false
    int state = 0
    int result = 0
    int touchBar
    int endBar
    int endTime
    bool nearArmed = false
    bool nearSent = false
    int extra = 0
    bool jumped = false
    line lnE
    line lnS
    line lnT
    line lnFt
    line lnFb
    line ln1R
    label lbP

// ---------- Eingaben (26) ----------
string G_P = "Zeitrahmen-Profil"
string profileSel = input.string("Auto", "Profil", options = ["Auto", "Manuell"], group = G_P, tooltip = "Auto wählt die Startwerte nach dem Chart-Zeitrahmen (M1, M2, M5; höhere Zeitrahmen nutzen das M5-Profil). Bei 'Manuell' gelten die Werte der Gruppe 'Manuelle Werte'.")

string G_M = "Manuelle Werte (nur bei Profil 'Manuell')"
int swingMin = input.int(25, "Swing-Pivot-Stärke (Minuten je Seite)", minval = 5, group = G_M)
float swingMinAtr = input.float(1.0, "Mindest-Ausschlag des Swings (× ATR)", minval = 0.0, step = 0.1, group = G_M)
int levelMaxAgeMin = input.int(1440, "Max. Alter eines Swing-Levels (Minuten)", minval = 60, group = G_M)
float fvgMinAtr = input.float(0.3, "Min. FVG-Größe (× ATR)", minval = 0.0, step = 0.05, group = G_M)
float slBufAtr = input.float(0.15, "SL-Puffer hinter der FVG (× ATR)", minval = 0.0, step = 0.05, group = G_M)
float minSlAtr = input.float(0.3, "Mindest-SL-Abstand (× ATR)", minval = 0.0, step = 0.1, group = G_M)
float minRR = input.float(1.5, "Mindest-RR (TP = nächstes Level)", minval = 0.5, step = 0.1, group = G_M)
int waitFvgMin = input.int(100, "Zeitfenster nach dem Sweep für die FVG (Minuten)", minval = 5, group = G_M)
int waitReturnMin = input.int(150, "Max. Minuten von der FVG bis zum Rücklauf", minval = 5, group = G_M)
int maxPlansIn = input.int(3, "Max. gleichzeitig offene Pläne", minval = 1, maxval = 10, group = G_M)

string G_TR = "Trend"
string trendMode = input.string("H4", "Trend-Filter", options = ["Aus", "M5", "M15", "H1", "H4"], group = G_TR, tooltip = "Setups gegen den Trend (oder bei neutralem Trend) werden nicht gesperrt, sondern mit ⚠ markiert und lösen keine Alarme aus. Trend = Strukturbruch im gewählten Zeitrahmen. 'Aus' = alle Setups gelten als Mit-Trend.")
bool showCounter = input.bool(true, "Gegen-Trend-Setups anzeigen (⚠, ohne Alarm)", group = G_TR)

string G_S = "Setup"
string sweepKind = input.string("Beide", "Sweep-Art", options = ["Beide", "Nur Grab", "Nur Sweep"], group = G_S, tooltip = "Grab: Close zurück im Level innerhalb von 1–3 Kerzen. Sweep: Der Preis bleibt mindestens 6 Minuten jenseits des Levels und kehrt dann zurück.")
string entryMode = input.string("Mitte", "Einstieg in der FVG", options = ["Obere Kante", "Mitte", "Untere Kante"], group = G_S)
bool useKeyLv = input.bool(true, "Schlüssel-Levels (Vortag, Vorwoche, Asia-Range)", group = G_S, tooltip = "Vortageshoch/-tief, Vorwochenhoch/-tief und Asia-Range-Hoch/-Tief (00:00–07:00 Wien) zählen zusätzlich als Liquidität und immer als stark (★).")

string G_A = "Alarme"
string minGrade = input.string("C", "Alarme ab Note", options = ["C", "B", "A"], group = G_A)
string alertFmt = input.string("Klartext", "Format (bei 'Any alert() function call')", options = ["Klartext", "JSON", "Beides"], group = G_A, tooltip = "Ein Alarm 'Any alert() function call' funktioniert auch auf einer ganzen Watchlist.")
bool nearOn = input.bool(true, "Nähe-Alarm vor dem Entry", group = G_A)
bool alLon = input.bool(true, "Alarme in London (08:00–13:00 Wien)", group = G_A, tooltip = "Gilt für neue Pläne. Sind alle drei Sessions an, kommen Alarme rund um die Uhr. Pläne außerhalb der Sessions werden angezeigt, aber ohne Alarm.")
bool alNyAm = input.bool(true, "Alarme in New York AM (08:30–12:00 NY)", group = G_A)
bool alNyPm = input.bool(true, "Alarme in New York PM (12:00–16:00 NY)", group = G_A)

string G_L = "Lot-Rechner"
float account = input.float(10000.0, "Kontogröße", minval = 1.0, group = G_L)
float riskPct = input.float(0.5, "Risiko pro Trade (%)", minval = 0.01, step = 0.1, group = G_L, tooltip = "Näherung über den Punktwert des Symbols. Vor dem Handel mit dem Lot-Rechner von Pepperstone gegenprüfen.")

string G_D = "Anzeige"
bool showHist = input.bool(true, "Historie (abgeschlossene Pläne bleiben als Linien)", group = G_D)
string tblSizeIn = input.string("small", "Tabellengröße", options = ["tiny", "small", "normal", "large", "huge"], group = G_D)

// ---------- Feste Werte (früher Einstellungen) ----------
int trendPivot = 5
int sweepMinMin = 6
int sweepMaxMin = 30
int closeBackN = 3
float depthMinAtr = 0.1
float depthMaxAtr = 1.0
float dispAtr = 0.7
float strongMult = 2.0
float eqTolAtr = 0.1
int maxLevels = 12
int atrLen = 14
float nearAtr = 0.5
int maxHist = 40
int fadeMin = 30
string sessAsia = "0000-0700"

color cTblBg = color.rgb(235, 235, 235)
color cTblHead = color.rgb(200, 200, 200)
color cTblText = color.black
color cEntry = color.gray
color cSl = color.red
color cTp = color.green
color c1R = color.new(color.gray, 40)
color cFvgLine = color.aqua
color cSweepLine = color.orange
color cLblLong = color.lime
color cLblShort = color.red
color cLblCounter = color.rgb(170, 170, 170)
color cLblText = color.black
color cHistTp = color.green
color cHistSl = color.red
color cHistNone = color.gray

int minGradeV = minGrade == "A" ? 3 : minGrade == "B" ? 2 : 1
string tblSize = tblSizeIn == "tiny" ? size.tiny : tblSizeIn == "normal" ? size.normal : tblSizeIn == "large" ? size.large : tblSizeIn == "huge" ? size.huge : size.small

// ---------- reine Hilfsfunktionen ----------
f_bos(int len) =>
    float bph = ta.pivothigh(high, len, len)
    float bpl = ta.pivotlow(low, len, len)
    var float lastH = na
    var float lastL = na
    var int bt = 0
    if not na(bph)
        lastH := bph
    if not na(bpl)
        lastL := bpl
    if not na(lastH) and close > lastH
        bt := 1
    else if not na(lastL) and close < lastL
        bt := -1
    bt

f_arrow(int b) =>
    b == 1 ? "▲" : b == -1 ? "▼" : "–"

f_tfName(int sec) =>
    sec < 3600 ? "M" + str.tostring(math.round(sec / 60)) : sec < 86400 ? "H" + str.tostring(math.round(sec / 3600)) : sec < 604800 ? "T" : "W"

f_hasEq(array<float> arr, int idx, float tol) =>
    bool res = false
    int q = 0
    while q < array.size(arr)
        if q != idx and math.abs(array.get(arr, q) - array.get(arr, idx)) <= tol
            res := true
        q += 1
    res

f_tp(array<float> arr, float entry, float risk, float rrMin, bool isLong) =>
    float res = na
    int q = array.size(arr) - 1
    while q >= 0
        float v = array.get(arr, q)
        if isLong
            if v > entry and (v - entry) / risk >= rrMin
                res := na(res) ? v : math.min(res, v)
        else
            if v < entry and (entry - v) / risk >= rrMin
                res := na(res) ? v : math.max(res, v)
        q -= 1
    res

f_levels(bool isL, float fTop, float fBot, float atrV, string eMode, float buf, float minSl, float minRRv, array<float> hArr, array<float> lArr) =>
    float ent = eMode == "Obere Kante" ? fTop : eMode == "Untere Kante" ? fBot : (fTop + fBot) / 2.0
    float base = isL ? fBot - atrV * buf : fTop + atrV * buf
    float risk = math.max(math.abs(ent - base), atrV * minSl)
    float slv = isL ? ent - risk : ent + risk
    float tpv = isL ? f_tp(hArr, ent, risk, minRRv, true) : f_tp(lArr, ent, risk, minRRv, false)
    float rrv = na(tpv) ? na : math.abs(tpv - ent) / risk
    [ent, slv, tpv, rrv]

f_grade(float rr, bool h4ok, bool eq, float fSz, float atrV, bool strong) =>
    int pts = (rr >= 2.0 ? 1 : 0) + (rr >= 3.0 ? 1 : 0) + (h4ok ? 1 : 0) + (eq ? 1 : 0) + (fSz >= atrV * 0.5 ? 1 : 0) + (strong ? 1 : 0)
    pts >= 4 ? "A" : pts >= 2 ? "B" : "C"

f_gv(string g) =>
    g == "A" ? 3 : g == "B" ? 2 : 1

f_x2(line l, int x) =>
    if not na(l)
        line.set_x2(l, x)
    0

f_ly(line l, float y) =>
    if not na(l)
        line.set_y1(l, y)
        line.set_y2(l, y)
    0

f_col(line l, color c) =>
    if not na(l)
        line.set_color(l, c)
    0

f_dl(line l) =>
    if not na(l)
        line.delete(l)
    0

f_px(float v) =>
    str.tostring(v, format.mintick)

// ---------- Basiswerte ----------
bool bc = barstate.isconfirmed
float atr = nz(ta.atr(atrLen), syminfo.mintick)
int tfSec = timeframe.in_seconds()
float tfMin = math.max(1.0, tfSec / 60.0)
bool chartIsM5 = tfSec >= 300
string tfName = f_tfName(tfSec)

// ---------- Zeitrahmen-Profil ----------
string profAuto = tfSec <= 60 ? "M1" : tfSec <= 150 ? "M2" : "M5"
string prof = profileSel == "Auto" ? profAuto : "Manuell"

int pSwingMin = prof == "Manuell" ? swingMin : prof == "M1" ? 30 : prof == "M2" ? 30 : 25
float pSwingAtr = prof == "Manuell" ? swingMinAtr : prof == "M1" ? 3.0 : prof == "M2" ? 2.0 : 1.0
int pLevelAge = prof == "Manuell" ? levelMaxAgeMin : 1440
float pFvgMin = prof == "Manuell" ? fvgMinAtr : prof == "M1" ? 0.4 : prof == "M2" ? 0.3 : 0.3
float pSlBuf = prof == "Manuell" ? slBufAtr : prof == "M1" ? 0.3 : prof == "M2" ? 0.2 : 0.15
float pMinSl = prof == "Manuell" ? minSlAtr : prof == "M1" ? 0.7 : prof == "M2" ? 0.5 : 0.3
float pMinRR = prof == "Manuell" ? minRR : prof == "M1" ? 2.0 : 1.5
int pWaitFvg = prof == "Manuell" ? waitFvgMin : prof == "M1" ? 30 : prof == "M2" ? 60 : 100
int pWaitRet = prof == "Manuell" ? waitReturnMin : prof == "M1" ? 45 : prof == "M2" ? 90 : 150
int pMaxPlans = prof == "Manuell" ? maxPlansIn : 3

int swingLenB = math.max(2, math.round(pSwingMin / tfMin))
int levelAgeB = math.max(1, math.round(pLevelAge / tfMin))
int dayB = math.max(1, math.round(1440 / tfMin))
int weekB = math.max(1, math.round(10080 / tfMin))
int waitFvgB = math.max(3, math.round(pWaitFvg / tfMin))
int waitRetB = math.max(1, math.round(pWaitRet / tfMin))
int sweepMinB = math.max(2, math.ceil(sweepMinMin / tfMin))
int sweepMaxB = math.max(sweepMinB + 1, math.round(sweepMaxMin / tfMin))
int trackMaxB = math.max(10, math.round(600 / tfMin))
float fvgMin = atr * pFvgMin

// ---------- Trend (zuletzt abgeschlossene Kerze des jeweiligen Zeitrahmens) ----------
int trM5 = nz(request.security(syminfo.tickerid, "5", f_bos(trendPivot)[1], lookahead = barmerge.lookahead_on))
int trM15 = nz(request.security(syminfo.tickerid, "15", f_bos(trendPivot)[1], lookahead = barmerge.lookahead_on))
int trH1n = nz(request.security(syminfo.tickerid, "60", f_bos(trendPivot)[1], lookahead = barmerge.lookahead_on))
int trH4n = nz(request.security(syminfo.tickerid, "240", f_bos(trendPivot)[1], lookahead = barmerge.lookahead_on))
int trend = trendMode == "M5" ? trM5 : trendMode == "M15" ? trM15 : trendMode == "H1" ? trH1n : trendMode == "H4" ? trH4n : 0
float trendTfMin = trendMode == "M5" ? 5.0 : trendMode == "M15" ? 15.0 : trendMode == "H1" ? 60.0 : trendMode == "H4" ? 240.0 : 0.0
bool trendTooSmall = trendMode != "Aus" and trendTfMin < tfMin

// ---------- M5-FVGs (zuletzt abgeschlossene M5-Kerze) ----------
[m5L1, m5H3, m5H1, m5L3, m5T1, m5T3] = request.security(syminfo.tickerid, "5", [low[1], high[3], high[1], low[3], time[1], time[3]], lookahead = barmerge.lookahead_on)
bool m5New = not na(m5T1) and m5T1 != nz(m5T1[1])

var float m5bTop = na
var float m5bBot = na
var int m5bT1 = na
var int m5bT3 = na
var float m5sTop = na
var float m5sBot = na
var int m5sT1 = na
var int m5sT3 = na
if bc and m5New
    if m5L1 > m5H3 and m5L1 - m5H3 >= fvgMin
        m5bTop := m5L1
        m5bBot := m5H3
        m5bT1 := m5T1
        m5bT3 := m5T3
    if m5L3 > m5H1 and m5L3 - m5H1 >= fvgMin
        m5sTop := m5L3
        m5sBot := m5H1
        m5sT1 := m5T1
        m5sT3 := m5T3

// ---------- Sessions für Alarme ----------
bool inLon = not na(time(timeframe.period, "0800-1300", "Europe/Vienna"))
bool inNyAm = not na(time(timeframe.period, "0830-1200", "America/New_York"))
bool inNyPm = not na(time(timeframe.period, "1200-1600", "America/New_York"))
bool allSess = alLon and alNyAm and alNyPm
bool sessOk = allSess or (alLon and inLon) or (alNyAm and inNyAm) or (alNyPm and inNyPm)

// ---------- Funktionen mit Zugriff auf Eingaben ----------
f_planTxt(Plan p) =>
    (p.withTrend ? "" : "⚠ ") + (p.dir == 1 ? "LONG " : "SHORT ") + p.grade + " " + str.tostring(p.rr, "#.#") + (p.strong ? " ★" : "")

f_planDraw(Plan p) =>
    int x = bar_index
    p.lnE := line.new(x, p.entry, x + 1, p.entry, color = cEntry, style = line.style_dashed)
    p.lnS := line.new(x, p.sl, x + 1, p.sl, color = cSl)
    p.lnT := line.new(x, p.tp, x + 1, p.tp, color = cTp)
    color lc = not p.withTrend ? cLblCounter : p.dir == 1 ? cLblLong : cLblShort
    p.lbP := label.new(x, p.entry, f_planTxt(p), style = p.dir == 1 ? label.style_label_up : label.style_label_down, color = lc, textcolor = cLblText, size = size.tiny)
    float oneR = p.dir == 1 ? p.entry + math.abs(p.entry - p.sl) : p.entry - math.abs(p.entry - p.sl)
    p.ln1R := line.new(x, oneR, x + 1, oneR, color = c1R, style = line.style_dotted)
    p.lnFt := line.new(x, p.top, x + 1, p.top, color = cFvgLine)
    p.lnFb := line.new(x, p.bot, x + 1, p.bot, color = cFvgLine)
    0

f_planMove(Plan p) =>
    f_ly(p.lnE, p.entry)
    f_ly(p.lnS, p.sl)
    f_ly(p.lnT, p.tp)
    f_ly(p.lnFt, p.top)
    f_ly(p.lnFb, p.bot)
    float oneR = p.dir == 1 ? p.entry + math.abs(p.entry - p.sl) : p.entry - math.abs(p.entry - p.sl)
    f_ly(p.ln1R, oneR)
    if not na(p.lbP)
        label.set_y(p.lbP, p.entry)
        label.set_text(p.lbP, f_planTxt(p))
    0

f_planExt(Plan p, int x) =>
    f_x2(p.lnE, x)
    f_x2(p.lnS, x)
    f_x2(p.lnT, x)
    f_x2(p.lnFt, x)
    f_x2(p.lnFb, x)
    f_x2(p.ln1R, x)
    0

f_planDel(Plan p) =>
    f_dl(p.lnE)
    f_dl(p.lnS)
    f_dl(p.lnT)
    f_dl(p.lnFt)
    f_dl(p.lnFb)
    f_dl(p.ln1R)
    if not na(p.lbP)
        label.delete(p.lbP)
    0

// Zähler: 0 Pläne, 1 mit Alarm, 2 berührt, 3 TP, 4 SL | Ergebnis in R (Risikoeinheiten)
var array<int> st = array.new<int>(5, 0)
var array<float> rSum = array.new<float>(1, 0.0)

// Ergebnis: 1 = TP, -1 = SL, 0 = nie gefüllt / ungültig / offen. Das Label verschwindet, die Linien bleiben farbig.
f_finish(Plan p, int res) =>
    p.state := 2
    p.result := res
    p.endBar := bar_index
    p.endTime := time
    color c = res == 1 ? cHistTp : res == -1 ? cHistSl : cHistNone
    f_col(p.lnE, c)
    f_col(p.lnS, c)
    f_col(p.lnT, c)
    f_col(p.lnFt, color.new(c, 40))
    f_col(p.lnFb, color.new(c, 40))
    f_col(p.ln1R, color.new(c, 60))
    f_planExt(p, bar_index)
    if not na(p.lbP)
        label.delete(p.lbP)
        p.lbP := na
    if res == 1
        array.set(st, 3, array.get(st, 3) + 1)
        array.set(rSum, 0, array.get(rSum, 0) + p.rr)
    else if res == -1
        array.set(st, 4, array.get(st, 4) + 1)
        array.set(rSum, 0, array.get(rSum, 0) - 1.0)
    0

f_txt(string evt, Plan p) =>
    string head = syminfo.ticker + " " + tfName + " " + (p.dir == 1 ? "LONG" : "SHORT")
    string res = ""
    if evt == "SETUP"
        res := head + " " + p.grade + " · E " + f_px(p.entry) + " · SL " + f_px(p.sl) + " · TP " + f_px(p.tp) + " · RR " + str.tostring(p.rr, "#.#")
    else if evt == "UPDATE"
        res := head + " neu · E " + f_px(p.entry) + " · SL " + f_px(p.sl) + " · TP " + f_px(p.tp)
    else if evt == "NEAR"
        res := head + " nahe " + f_px(p.entry)
    else if evt == "TOUCH"
        res := head + " berührt " + f_px(p.entry)
    else
        res := head + " ungültig → Limit löschen"
    res

f_json(string evt, Plan p) =>
    '{"event":"' + evt + '","side":"' + (p.dir == 1 ? "BUY" : "SELL") + '","symbol":"' + syminfo.ticker + '","tf":"' + tfName + '","entry":' + f_px(p.entry) + ',"sl":' + f_px(p.sl) + ',"tp":' + f_px(p.tp) + ',"rr":' + str.tostring(p.rr, "#.0") + ',"grade":"' + p.grade + '"}'

f_send(string evt, Plan p) =>
    if p.alerted
        if alertFmt != "JSON"
            alert(f_txt(evt, p), alert.freq_all)
        if alertFmt != "Klartext"
            alert(f_json(evt, p), alert.freq_all)
    0

// ---------- Liquidität: Swings + Schlüssel-Levels ----------
// je Level: Preis, Ursprungs-Kerze, Ablauf-Kerze, Stärke
var array<float> hP = array.new<float>()
var array<int> hB = array.new<int>()
var array<int> hX = array.new<int>()
var array<float> hS = array.new<float>()
var array<float> lP = array.new<float>()
var array<int> lB = array.new<int>()
var array<int> lX = array.new<int>()
var array<float> lS = array.new<float>()

float ph = ta.pivothigh(high, swingLenB, swingLenB)
float pl = ta.pivotlow(low, swingLenB, swingLenB)
float hiWin = ta.highest(high, 2 * swingLenB + 1)
float loWin = ta.lowest(low, 2 * swingLenB + 1)

// Vortag / Vorwoche / Asia-Range mitlaufend bestimmen
bool newDay = ta.change(time("D")) != 0
bool newWeek = ta.change(time("W")) != 0
bool inAs = not na(time(timeframe.period, sessAsia, "Europe/Vienna"))
bool asEnd = inAs[1] and not inAs
var float dHi = na
var float dLo = na
var float wHi = na
var float wLo = na
var float aHi = na
var float aLo = na
float pdH = na
float pdL = na
float pwH = na
float pwL = na
float asH = na
float asL = na
if newDay
    pdH := dHi
    pdL := dLo
    dHi := high
    dLo := low
else
    dHi := na(dHi) ? high : math.max(dHi, high)
    dLo := na(dLo) ? low : math.min(dLo, low)
if newWeek
    pwH := wHi
    pwL := wLo
    wHi := high
    wLo := low
else
    wHi := na(wHi) ? high : math.max(wHi, high)
    wLo := na(wLo) ? low : math.min(wLo, low)
if asEnd
    asH := aHi
    asL := aLo
if inAs
    aHi := inAs[1] and not na(aHi) ? math.max(aHi, high) : high
    aLo := inAs[1] and not na(aLo) ? math.min(aLo, low) : low

// ---------- welche Levels nimmt diese Kerze? Das stärkste zählt ----------
float tkLowLvl = na
int tkLowBar = na
bool tkLowEq = false
float tkLowStr = na
float tkHighLvl = na
int tkHighBar = na
bool tkHighEq = false
float tkHighStr = na

if bc
    float eqTol = atr * eqTolAtr
    int a1 = 0
    while a1 < array.size(lP)
        float lvA = array.get(lP, a1)
        if low < lvA
            bool eqA = f_hasEq(lP, a1, eqTol)
            float sA = array.get(lS, a1) + (eqA ? 1.0 : 0.0)
            if na(tkLowStr) or sA > tkLowStr or (sA == tkLowStr and lvA < tkLowLvl)
                tkLowLvl := lvA
                tkLowBar := array.get(lB, a1)
                tkLowEq := eqA
                tkLowStr := sA
        a1 += 1
    int a2 = 0
    while a2 < array.size(hP)
        float lvB = array.get(hP, a2)
        if high > lvB
            bool eqB = f_hasEq(hP, a2, eqTol)
            float sB = array.get(hS, a2) + (eqB ? 1.0 : 0.0)
            if na(tkHighStr) or sB > tkHighStr or (sB == tkHighStr and lvB > tkHighLvl)
                tkHighLvl := lvB
                tkHighBar := array.get(hB, a2)
                tkHighEq := eqB
                tkHighStr := sB
        a2 += 1
    // abgeholte Levels sind verbraucht, abgelaufene fallen weg
    int r1 = array.size(lP) - 1
    while r1 >= 0
        if low < array.get(lP, r1) or bar_index > array.get(lX, r1)
            array.remove(lP, r1)
            array.remove(lB, r1)
            array.remove(lX, r1)
            array.remove(lS, r1)
        r1 -= 1
    int r2 = array.size(hP) - 1
    while r2 >= 0
        if high > array.get(hP, r2) or bar_index > array.get(hX, r2)
            array.remove(hP, r2)
            array.remove(hB, r2)
            array.remove(hX, r2)
            array.remove(hS, r2)
        r2 -= 1
    // neue signifikante Swings
    float minAmp = math.max(pSwingAtr * atr, syminfo.mintick)
    if not na(ph) and ph - loWin >= pSwingAtr * atr
        array.push(hP, ph)
        array.push(hB, bar_index - swingLenB)
        array.push(hX, bar_index - swingLenB + levelAgeB)
        array.push(hS, (ph - loWin) / minAmp)
    if not na(pl) and hiWin - pl >= pSwingAtr * atr
        array.push(lP, pl)
        array.push(lB, bar_index - swingLenB)
        array.push(lX, bar_index - swingLenB + levelAgeB)
        array.push(lS, (hiWin - pl) / minAmp)
    // Schlüssel-Levels (immer stark): Vortag und Asia 1 Tag gültig, Vorwoche 1 Woche
    float kS = strongMult + 1.0
    if useKeyLv and newDay and not na(pdH) and not na(pdL)
        array.push(hP, pdH)
        array.push(hB, bar_index)
        array.push(hX, bar_index + dayB)
        array.push(hS, kS)
        array.push(lP, pdL)
        array.push(lB, bar_index)
        array.push(lX, bar_index + dayB)
        array.push(lS, kS)
    if useKeyLv and newWeek and not na(pwH) and not na(pwL)
        array.push(hP, pwH)
        array.push(hB, bar_index)
        array.push(hX, bar_index + weekB)
        array.push(hS, kS)
        array.push(lP, pwL)
        array.push(lB, bar_index)
        array.push(lX, bar_index + weekB)
        array.push(lS, kS)
    if useKeyLv and asEnd and not na(asH) and not na(asL)
        array.push(hP, asH)
        array.push(hB, bar_index)
        array.push(hX, bar_index + dayB)
        array.push(hS, kS)
        array.push(lP, asL)
        array.push(lB, bar_index)
        array.push(lX, bar_index + dayB)
        array.push(lS, kS)
    while array.size(hP) > maxLevels
        array.shift(hP)
        array.shift(hB)
        array.shift(hX)
        array.shift(hS)
    while array.size(lP) > maxLevels
        array.shift(lP)
        array.shift(lB)
        array.shift(lX)
        array.shift(lS)

// =====================================================================
// SWEEP-ZUSTAND: 0 = wartet, 1 = Sweep läuft, 2 = Sweep fertig → Reaktion + FVG abwarten
// =====================================================================
var int phase = 0
var int sdir = 0
var float swLevel = na
var float swExt = na
var int swStartBar = na
var int swCompBar = na
var int swCompTime = na
var string swKind = ""
var bool swEq = false
var bool swStrong = false
var int swLvBar = na
var bool swReact = false

bool sweepDone = false
bool kindGrabOk = sweepKind != "Nur Sweep"
bool kindSweepOk = sweepKind != "Nur Grab"
float dMin = atr * depthMinAtr
float dMax = atr * depthMaxAtr

if bc
    if phase == 1
        bool back = sdir == 1 ? close > swLevel : close < swLevel
        swExt := sdir == 1 ? math.min(swExt, low) : math.max(swExt, high)
        float depth = sdir == 1 ? swLevel - swExt : swExt - swLevel
        if bar_index - swStartBar > sweepMaxB or depth > dMax
            phase := 0
        else if back
            int nBeyond = bar_index - swStartBar
            string kd = nBeyond < closeBackN ? "Grab" : nBeyond >= sweepMinB ? "Sweep" : ""
            bool kOk = kd == "Grab" ? kindGrabOk : kd == "Sweep" ? kindSweepOk : false
            if kOk and depth >= dMin
                phase := 2
                swKind := kd
                swCompBar := bar_index
                swCompTime := time
                swReact := false
                sweepDone := true
            else
                phase := 0
    else if phase == 0
        bool tkL = not na(tkLowLvl)
        bool tkH = not na(tkHighLvl)
        if tkL and not tkH
            bool backNow = close > tkLowLvl
            float dep = tkLowLvl - low
            bool okNow = backNow ? kindGrabOk and dep >= dMin and dep <= dMax : dep <= dMax
            if okNow
                sdir := 1
                swLevel := tkLowLvl
                swExt := low
                swStartBar := bar_index
                swLvBar := tkLowBar
                swEq := tkLowEq
                swStrong := tkLowStr >= strongMult
                if backNow
                    phase := 2
                    swKind := "Grab"
                    swCompBar := bar_index
                    swCompTime := time
                    swReact := false
                    sweepDone := true
                else
                    phase := 1
        else if tkH and not tkL
            bool backNow2 = close < tkHighLvl
            float dep2 = high - tkHighLvl
            bool okNow2 = backNow2 ? kindGrabOk and dep2 >= dMin and dep2 <= dMax : dep2 <= dMax
            if okNow2
                sdir := -1
                swLevel := tkHighLvl
                swExt := high
                swStartBar := bar_index
                swLvBar := tkHighBar
                swEq := tkHighEq
                swStrong := tkHighStr >= strongMult
                if backNow2
                    phase := 2
                    swKind := "Grab"
                    swCompBar := bar_index
                    swCompTime := time
                    swReact := false
                    sweepDone := true
                else
                    phase := 1

// Reaktion: Verdrängungskerze in Gegenrichtung (ab der Close-Back-Kerze)
if bc and phase == 2 and not swReact
    float body = sdir == 1 ? close - open : open - close
    if body >= dispAtr * atr
        swReact := true

// Trend-Status des Sweeps, festgehalten beim Close-Back (nur Markierung, keine Sperre)
var bool swWithTrend = true
if sweepDone
    swWithTrend := trendMode == "Aus" or trend == sdir

var array<line> swLines = array.new<line>()
if sweepDone
    array.push(swLines, line.new(swLvBar, swLevel, bar_index, swLevel, color = cSweepLine, style = line.style_dotted))
    if array.size(swLines) > 30
        line.delete(array.shift(swLines))

// =====================================================================
// PLÄNE
// =====================================================================
var array<Plan> plans = array.new<Plan>()

bool fvgBullNow = low > high[2] and low - high[2] >= fvgMin
bool fvgBearNow = high < low[2] and low[2] - high >= fvgMin

bool apNewL = false
bool apNewS = false
bool apUpd = false
bool apNear = false
bool apTouchL = false
bool apTouchS = false
bool apCancel = false
bool dpCntL = false
bool dpCntS = false
int finCnt = 0

// ---------- bestehende Pläne verwalten ----------
if bc
    int k = array.size(plans) - 1
    while k >= 0
        Plan p = array.get(plans, k)
        bool isL = p.dir == 1
        bool gk = p.alerted
        bool delIt = false
        if p.state == 0 and bar_index > p.birth
            bool touch = isL ? low <= p.entry : high >= p.entry
            bool tpFirst = isL ? high >= p.tp : low <= p.tp
            bool broken = isL ? close < p.bot : close > p.top
            bool expired = bar_index - p.birth > waitRetB
            if touch
                p.state := 1
                p.touchBar := bar_index
                array.set(st, 2, array.get(st, 2) + 1)
                if gk
                    if isL
                        apTouchL := true
                    else
                        apTouchS := true
                f_send("TOUCH", p)
                bool slNow = isL ? low <= p.sl : high >= p.sl
                if slNow
                    f_finish(p, -1)
                else
                    f_planExt(p, bar_index + 1)
            else if tpFirst or broken or expired
                if gk
                    apCancel := true
                f_send("CANCEL", p)
                f_finish(p, 0)
            else
                float dist = isL ? close - p.entry : p.entry - close
                if nearOn
                    if dist > nearAtr * atr
                        p.nearArmed := true
                    else if p.nearArmed and not p.nearSent and dist > 0
                        p.nearSent := true
                        if gk
                            apNear := true
                        f_send("NEAR", p)
                if not chartIsM5 and not p.jumped
                    bool nf = isL ? fvgBullNow : fvgBearNow
                    if nf and bar_index - 2 >= p.sweepBar and bar_index <= p.winEnd
                        p.extra += 1
                    if p.extra >= 1
                        float zT = isL ? m5bTop : m5sTop
                        float zB = isL ? m5bBot : m5sBot
                        int zT1 = isL ? m5bT1 : m5sT1
                        int zT3 = isL ? m5bT3 : m5sT3
                        bool zOk = not na(zT) and not na(zT3) and not na(zT1)
                        if zOk
                            zOk := zT3 + 300000 > p.sweepTime and zT1 <= p.sweepTime + pWaitFvg * 60000
                        if zOk
                            zOk := math.abs(zT - p.top) > syminfo.mintick or math.abs(zB - p.bot) > syminfo.mintick
                        if zOk
                            zOk := isL ? close > zB : close < zT
                        if zOk
                            [jE, jS, jT, jR] = f_levels(isL, zT, zB, atr, entryMode, pSlBuf, pMinSl, pMinRR, hP, lP)
                            if not na(jT) and (isL ? close > jE : close < jE)
                                p.top := zT
                                p.bot := zB
                                p.entry := jE
                                p.sl := jS
                                p.tp := jT
                                p.rr := jR
                                p.fvgSz := zT - zB
                                p.grade := f_grade(jR, p.h4ok, p.eq, p.fvgSz, atr, p.strong)
                                f_planMove(p)
                                apUpd := apUpd or gk
                                f_send("UPDATE", p)
                            p.jumped := true
                f_planExt(p, bar_index + 1)
        else if p.state == 1 and bar_index > p.touchBar
            bool slHit = isL ? low <= p.sl : high >= p.sl
            bool tpHit = isL ? high >= p.tp : low <= p.tp
            if slHit
                f_finish(p, -1)
            else if tpHit
                f_finish(p, 1)
            else if bar_index - p.touchBar > trackMaxB
                f_finish(p, 0)
            else
                f_planExt(p, bar_index + 1)
        else if p.state == 2
            finCnt += 1
            if showHist
                delIt := finCnt > maxHist
            else
                delIt := time - p.endTime > fadeMin * 60000
        if delIt
            f_planDel(p)
            array.remove(plans, k)
        k -= 1

// ---------- neuer Plan aus der ersten FVG nach der Reaktion ----------
if bc and phase == 2
    if bar_index - swCompBar > waitFvgB
        phase := 0
    else if bar_index - 2 >= swCompBar and swReact
        bool isLn = sdir == 1
        bool fv = isLn ? fvgBullNow : fvgBearNow
        if fv and not swWithTrend and not showCounter
            phase := 0
        else if fv
            float fTop = isLn ? low : low[2]
            float fBot = isLn ? high[2] : high
            [nE, nS, nT, nR] = f_levels(isLn, fTop, fBot, atr, entryMode, pSlBuf, pMinSl, pMinRR, hP, lP)
            if not na(nT)
                bool h4n = trH4n == sdir
                string gr = f_grade(nR, h4n, swEq, fTop - fBot, atr, swStrong)
                Plan np = Plan.new(dir = sdir, top = fTop, bot = fBot, entry = nE, sl = nS, tp = nT, rr = nR, fvgSz = fTop - fBot, birth = bar_index, sweepBar = swCompBar, sweepTime = swCompTime, winEnd = swCompBar + waitFvgB, grade = gr, eq = swEq, h4ok = h4n, strong = swStrong, withTrend = swWithTrend)
                np.alerted := swWithTrend and sessOk and f_gv(gr) >= minGradeV
                np.nearArmed := (isLn ? close - nE : nE - close) > nearAtr * atr
                f_planDraw(np)
                array.push(plans, np)
                array.set(st, 0, array.get(st, 0) + 1)
                if np.alerted
                    array.set(st, 1, array.get(st, 1) + 1)
                    if isLn
                        apNewL := true
                    else
                        apNewS := true
                else if not swWithTrend
                    if isLn
                        dpCntL := true
                    else
                        dpCntS := true
                f_send("SETUP", np)
                // zu viele offene Pläne: zuerst die ältesten ohne Alarm beenden, dann die ältesten übrigen
                int pendCnt = 0
                int ci = 0
                while ci < array.size(plans)
                    Plan pc = array.get(plans, ci)
                    if pc.state == 0
                        pendCnt += 1
                    ci += 1
                int pss = 0
                while pss < 2
                    int di = 0
                    while pendCnt > pMaxPlans and di < array.size(plans)
                        Plan op = array.get(plans, di)
                        if op.state == 0 and (pss == 1 or not op.alerted)
                            f_send("CANCEL", op)
                            f_finish(op, 0)
                            pendCnt -= 1
                        di += 1
                    pss += 1
            phase := 0

// =====================================================================
// DARSTELLUNG
// =====================================================================
bool mkSslG = sweepDone and sdir == 1 and swKind == "Grab" and not swEq
bool mkSslGe = sweepDone and sdir == 1 and swKind == "Grab" and swEq
bool mkSslS = sweepDone and sdir == 1 and swKind == "Sweep" and not swEq
bool mkSslSe = sweepDone and sdir == 1 and swKind == "Sweep" and swEq
bool mkBslG = sweepDone and sdir == -1 and swKind == "Grab" and not swEq
bool mkBslGe = sweepDone and sdir == -1 and swKind == "Grab" and swEq
bool mkBslS = sweepDone and sdir == -1 and swKind == "Sweep" and not swEq
bool mkBslSe = sweepDone and sdir == -1 and swKind == "Sweep" and swEq

plotshape(mkSslG, "SSL Grab", style = shape.triangleup, location = location.belowbar, color = color.lime, text = "SSL Grab", textcolor = color.black, size = size.tiny)
plotshape(mkSslGe, "SSL Grab (gleiche Tiefs)", style = shape.triangleup, location = location.belowbar, color = color.lime, text = "SSL Grab =", textcolor = color.black, size = size.tiny)
plotshape(mkSslS, "SSL Sweep", style = shape.triangleup, location = location.belowbar, color = color.lime, text = "SSL Sweep", textcolor = color.black, size = size.tiny)
plotshape(mkSslSe, "SSL Sweep (gleiche Tiefs)", style = shape.triangleup, location = location.belowbar, color = color.lime, text = "SSL Sweep =", textcolor = color.black, size = size.tiny)
plotshape(mkBslG, "BSL Grab", style = shape.triangledown, location = location.abovebar, color = color.red, text = "BSL Grab", textcolor = color.black, size = size.tiny)
plotshape(mkBslGe, "BSL Grab (gleiche Hochs)", style = shape.triangledown, location = location.abovebar, color = color.red, text = "BSL Grab =", textcolor = color.black, size = size.tiny)
plotshape(mkBslS, "BSL Sweep", style = shape.triangledown, location = location.abovebar, color = color.red, text = "BSL Sweep", textcolor = color.black, size = size.tiny)
plotshape(mkBslSe, "BSL Sweep (gleiche Hochs)", style = shape.triangledown, location = location.abovebar, color = color.red, text = "BSL Sweep =", textcolor = color.black, size = size.tiny)

plotshape(apNewL, "Plan bereit Long", style = shape.labelup, location = location.belowbar, color = color.new(color.yellow, 10), text = "LIMIT", textcolor = color.black, size = size.tiny)
plotshape(apNewS, "Plan bereit Short", style = shape.labeldown, location = location.abovebar, color = color.new(color.yellow, 10), text = "LIMIT", textcolor = color.black, size = size.tiny)
plotshape(dpCntL, "Plan Gegen-Trend Long", style = shape.labelup, location = location.belowbar, color = cLblCounter, text = "LIMIT ⚠", textcolor = color.black, size = size.tiny)
plotshape(dpCntS, "Plan Gegen-Trend Short", style = shape.labeldown, location = location.abovebar, color = cLblCounter, text = "LIMIT ⚠", textcolor = color.black, size = size.tiny)
plotshape(apTouchL, "Long: Level berührt", style = shape.labelup, location = location.belowbar, color = color.lime, text = "LONG", textcolor = color.black, size = size.small)
plotshape(apTouchS, "Short: Level berührt", style = shape.labeldown, location = location.abovebar, color = color.red, text = "SHORT", textcolor = color.black, size = size.small)

plotchar(trendMode != "Aus" and trend == 1, "Trend aufwärts", char = "■", location = location.bottom, color = color.new(color.green, 30), size = size.tiny)
plotchar(trendMode != "Aus" and trend == -1, "Trend abwärts", char = "■", location = location.bottom, color = color.new(color.red, 30), size = size.tiny)

// ---------- Alarmbedingungen (für feste Alarme je Ereignis) ----------
alertcondition(apNewL, "Plan LONG bereit", "LONG-Plan bereit")
alertcondition(apNewS, "Plan SHORT bereit", "SHORT-Plan bereit")
alertcondition(apUpd, "Plan verschoben", "Plan verschoben: Limit anpassen")
alertcondition(apNear, "Preis nahe Entry", "Preis nahe Entry")
alertcondition(apTouchL, "LONG berührt", "LONG: Limit berührt")
alertcondition(apTouchS, "SHORT berührt", "SHORT: Limit berührt")
alertcondition(apCancel, "Plan ungültig", "Plan ungültig → Limit löschen")

// ---------- Status-Tabelle ----------
var table status = table.new(position.top_right, 2, 6, border_width = 1)
if barstate.islast
    string setupState = phase == 0 ? "Warten" : sdir == 1 ? "Long-Sweep aktiv" : "Short-Sweep aktiv"
    color setupBg = phase == 0 ? cTblHead : sdir == 1 ? color.new(color.green, 40) : color.new(color.red, 40)
    string stageTxt = phase == 0 ? "Warten auf Sweep" : phase == 1 ? "Sweep läuft (" + str.tostring(bar_index - swStartBar) + " Kerzen)" : not swReact ? swKind + " → Reaktion abwarten" : swKind + " + Reaktion → FVG abwarten"
    if phase != 0 and not swWithTrend
        stageTxt := stageTxt + " (Gegen-Trend)"
    string trendTxt = trendMode == "Aus" ? "aus" : trend == 1 ? "aufwärts → Alarme Long" : trend == -1 ? "abwärts → Alarme Short" : "neutral → keine Alarme"
    if trendTooSmall
        trendTxt := trendTxt + " ⚠ < Chart"
    string arrows = "M5 " + f_arrow(trM5) + "  M15 " + f_arrow(trM15) + "  H1 " + f_arrow(trH1n) + "  H4 " + f_arrow(trH4n)
    int openCnt = 0
    Plan lp = na
    int oi = 0
    while oi < array.size(plans)
        Plan po = array.get(plans, oi)
        if po.state < 2
            lp := po
        if po.state == 0
            openCnt += 1
        oi += 1
    string lotTxt = "–"
    if not na(lp)
        float riskMoney = account * riskPct / 100.0
        float perLot = math.abs(lp.entry - lp.sl) * syminfo.pointvalue
        if perLot > 0
            lotTxt := str.tostring(riskMoney / perLot, "#.##") + " Lot · Risiko " + str.tostring(riskMoney, "#") + " " + syminfo.currency + " · RR " + str.tostring(lp.rr, "#.#")
    table.cell(status, 0, 0, "Ibo LTF 1.2", text_color = cTblText, bgcolor = cTblHead, text_size = tblSize)
    table.cell(status, 1, 0, setupState, text_color = cTblText, bgcolor = setupBg, text_size = tblSize)
    table.cell(status, 0, 1, "Ablauf", text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 1, 1, stageTxt, text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 0, 2, "Trend (" + trendMode + ")", text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 1, 2, trendTxt, text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 0, 3, "Struktur", text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 1, 3, arrows, text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 0, 4, "Profil / Pläne", text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 1, 4, prof + " · " + str.tostring(openCnt) + " offen" + (sessOk ? "" : " · Alarme aus (Session)"), text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 0, 5, "Lot (" + str.tostring(riskPct, "#.##") + "%)", text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)
    table.cell(status, 1, 5, lotTxt, text_color = cTblText, bgcolor = cTblBg, text_size = tblSize)

// ---------- Zähler im Datenfenster ----------
var int firstT = time
plot(array.get(st, 0), "Zähler: Pläne", display = display.data_window)
plot(array.get(st, 1), "Zähler: Pläne mit Alarm", display = display.data_window)
plot(array.get(st, 2), "Zähler: berührt", display = display.data_window)
plot(array.get(st, 3), "Zähler: TP", display = display.data_window)
plot(array.get(st, 4), "Zähler: SL", display = display.data_window)
plot(array.get(rSum, 0), "Zähler: Ergebnis (R)", display = display.data_window)
plot((time - firstT) / 86400000.0, "Zähler: Tage", display = display.data_window)
